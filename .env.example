APP_NAME="Aikchol Hospital LRDMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://lrdms.aikchol.local
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Primary DMS Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aikchol_lrdms
DB_USERNAME=lrdms_app
DB_PASSWORD=

# Dedicated Read-Only SQL Server 2014 Connection for Patient HN Lookup
# NEVER commit real credentials, hostnames, or IPs to Git
PATIENT_DB_ENABLED=false
PATIENT_DB_CONNECTION=sqlsrv
PATIENT_DB_HOST=
PATIENT_DB_PORT=1433
PATIENT_DB_DATABASE=
PATIENT_DB_USERNAME=
PATIENT_DB_PASSWORD=
PATIENT_DB_ENCRYPT=true
PATIENT_DB_TRUST_SERVER_CERTIFICATE=false
PATIENT_DB_LOGIN_TIMEOUT=5
PATIENT_DB_QUERY_TIMEOUT=10
PATIENT_DB_CHARSET=utf8

# Patient Lookup Security & Hashing
PATIENT_HASH_KEY=
PATIENT_HN_REGEX="/^[A-Za-z0-9\-]{4,20}$/"
PATIENT_LOOKUP_RATE_LIMIT_USER=30
PATIENT_LOOKUP_RATE_LIMIT_IP=60
PATIENT_LOOKUP_CACHE_ENABLED=false
PATIENT_LOOKUP_CACHE_TTL=30

# Document Storage & Policy (stored strictly outside public/)
DOCUMENT_MAX_FILE_SIZE_KB=20480
DOCUMENT_PREVIEW_URL_TTL=10
DOCUMENT_TMP_RETENTION_HOURS=24
DOCUMENT_PERMANENT_DELETE_ENABLED=false

# Session & Cookie Security (enforce HTTPS in Production)
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@aikchol.local"
MAIL_FROM_NAME="Aikchol Hospital LRDMS"

VITE_APP_NAME="${APP_NAME}"
